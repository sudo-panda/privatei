{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private-I",
  "version": "0.4.3",
  "identifier": "app.privatei.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build:ui",
      "cwd": "../.."
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Private-I",
        "width": 1120,
        "height": 780,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "HealthcareAndFitness",
    "shortDescription": "Private food, stock, medicine and training tracker",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/foods.sqlite": "resources/foods.sqlite"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBNzdBRDcyQzhGOTRGQzcKUldUSFQvbkljcTEzZWxQOTdnVzM0eDFmcVY1eXBIcGhNMXgwUzVKTUFwQVhzZkZ4dUwyKzlHTVEK",
      "endpoints": [
        "https://github.com/sudo-panda/privatei/releases/latest/download/latest.json"
      ]
    }
  }
}
